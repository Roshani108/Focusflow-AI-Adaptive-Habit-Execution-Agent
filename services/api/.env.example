# FocusFlow AI Backend Environment Configuration
ENVIRONMENT=development
DEBUG=True
PORT=8000

# Security
JWT_SECRET=supersecretjwtkeyfocusflowai2026productionreadysecurekey
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database - PostgreSQL with automatic SQLite fallback for local testing
DATABASE_URL=postgresql://focusflow_user:focusflow_password@localhost:5432/focusflow_db

# Redis
REDIS_URL=redis://localhost:6379/0

# AI Provider: 'mock' (default, offline & deterministic), 'openai', or 'groq'
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:19006,exp://localhost:8081
