# ==============================================================================
# FocusFlow AI - Unified Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
PORT=8000

# Security & Authentication
# Generate strong secrets using: openssl rand -hex 32
JWT_SECRET=supersecretjwtkeyfocusflowai2026productionreadysecurekey
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
# For local dev without docker, backend automatically falls back to SQLite if Postgres is unavailable
DATABASE_URL=postgresql://focusflow_user:focusflow_password@localhost:5432/focusflow_db
POSTGRES_USER=focusflow_user
POSTGRES_PASSWORD=focusflow_password
POSTGRES_DB=focusflow_db
POSTGRES_PORT=5432

# Redis Cache & Queue
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# AI Provider Settings
# Options: 'mock', 'openai', 'groq'
# When set to 'mock', the deterministic agent engine generates rich realistic plans without API keys
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# CORS & Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:19006,exp://localhost:8081

# Node.js Notification Service
NOTIFICATION_SERVICE_PORT=4000
NOTIFICATION_SERVICE_URL=http://localhost:4000

# React Web Client
VITE_API_BASE_URL=http://localhost:8000/api
VITE_NOTIFICATION_SERVICE_URL=http://localhost:4000
